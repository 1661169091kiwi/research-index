{
  "name": "research-index",
  "productName": "Research Index",
  "version": "1.8.5",
  "private": true,
  "type": "module",
  "description": "Bilingual (English / 涓枃) desktop index for research survey Markdown files.",
  "author": "Research Index",
  "main": "app/main.mjs",
  "scripts": {
    "start": "electron .",
    "build": "node build.mjs",
    "open": "node build.mjs --open",
    "icon": "node scripts/make-icon.mjs",
    "installer": "node scripts/installer.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.research-index.app",
    "productName": "Research Index",
    "copyright": "Research Index",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "src/**/*",
      "build.mjs",
      "package.json"
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Research Index",
      "installerIcon": "app/icon.ico",
      "uninstallerIcon": "app/icon.ico",
      "uninstallDisplayName": "Research Index",
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "multiLanguageInstaller": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "Research-Index-Setup-${version}.${ext}"
    }
  }
}
